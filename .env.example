# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Server HTTP port (default: 3000)
PORT="3000"

# NODE_ENV: Runtime environment ('development' | 'test' | 'production')
# In 'production', durable PostgreSQL configuration (DATABASE_URL or SQL_HOST) is mandatory.
# In 'development' and 'test', safely falls back to MemoryRepository if PostgreSQL is unconfigured.
NODE_ENV="development"

# SESSIONS:
# AIXSHOP v1.0 uses server-managed database-backed session records.
# Tokens are 256-bit unguessable random strings stored hashed via SHA-256 in the 'sessions' table
# and passed via HttpOnly cookies (aixshop_session) or Bearer authorization headers.
# No stateless cookie HMAC secret (e.g. SESSION_SECRET) is required or used by the server.

# DATABASE_URL: PostgreSQL connection URI (e.g., postgresql://user:password@host:5432/dbname)
# Required in production. In-memory database fallback is strictly prohibited in production.
DATABASE_URL=""

# Individual PostgreSQL connection parameters (alternative to DATABASE_URL):
# Precedence: DATABASE_URL > SQL_* > PG*
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""

# Standard PostgreSQL fallback variables (used if SQL_* parameters are omitted):
# PGHOST=""
# PGPORT="5432"
# PGUSER=""
# PGPASSWORD=""
# PGDATABASE=""

# PostgreSQL SSL / TLS Configuration:
# PGSSLMODE: SSL mode (e.g. 'require', 'verify-full', 'verify-ca')
# PGSSLROOTCERT: Path to CA root certificate file for verifying server certificates
# DATABASE_SSL: Set to 'true' to require SSL connection
# DATABASE_SSL_REJECT_UNAUTHORIZED: 'true' (default) to enforce CA verification. Set to 'false' only if self-signed certificates must be permitted.
PGSSLMODE=""
PGSSLROOTCERT=""
DATABASE_SSL=""
DATABASE_SSL_REJECT_UNAUTHORIZED="true"

# Database Setup & Migrations:
# - Execute pending schema migrations: npm run db:migrate
# - Inspect migration status: npm run db:status
# Applies src/server/db/migrations/001_initial_schema.sql safely and idempotently.

# BILLING & STRIPE CONFIGURATION:
# In 'production', Stripe is the required billing provider and fails closed if STRIPE_SECRET_KEY is missing.
# Silent fallback to sandbox billing in production is strictly prohibited.
# In 'development' and 'test', SandboxBillingProvider is used safely when Stripe credentials are not set.
BILLING_PROVIDER="stripe"

# STRIPE_SECRET_KEY: Secret API key from Stripe Dashboard (sk_live_... or sk_test_...)
# Used to create real Checkout Sessions and Customer Portal Sessions.
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Endpoint signing secret from Stripe Dashboard (whsec_...)
# Used to verify HMAC signatures against original raw request bytes.
STRIPE_WEBHOOK_SECRET=""

# Authoritative Stripe Price IDs for paid plans:
# Each plan requires a real, pre-configured Stripe Price ID matching the tier definition:
# - Starter: $49/mo (up to 250 verified SKUs)
# - Growth: $149/mo (up to 2,500 verified SKUs)
# - Enterprise: $499/mo (unlimited verified SKUs)
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_ENTERPRISE=""

# BILLING_WEBHOOK_SECRET: Secret for SandboxBillingProvider in development/test environments only.
BILLING_WEBHOOK_SECRET=""

# Health & Readiness Probes (Kubernetes / Cloud Run deployment):
# - Liveness Probe:  GET /api/health/live  (HTTP 200: Node process and event loop responsive)
# - Readiness Probe: GET /api/health/ready (HTTP 200: PostgreSQL connected and schema verified ready; HTTP 503 if unavailable)
# - General Monitor: GET /api/health       (HTTP 200: ready; HTTP 503: unavailable; supports ?probe=live)

