# ==============================================================================
# AIXSHOP v1.0 — Environment Configuration Reference
# ==============================================================================
# Copy to .env for local use. NEVER commit .env files or real secrets.
# All optional external integrations fail closed or report BLOCKED when absent.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DEVELOPMENT
# ------------------------------------------------------------------------------
# PORT: Server HTTP port (default: 3000)
PORT="3000"

# NODE_ENV: Runtime environment ('development' | 'test' | 'production')
# In 'production', durable PostgreSQL configuration (DATABASE_URL or SQL_HOST) is mandatory.
# In 'development' and 'test', safely falls back to MemoryRepository if PostgreSQL is unconfigured.
NODE_ENV="development"

# APP_URL: The URL where this applet is hosted.
# Mandatory HTTPS URL in production (localhost and MY_APP_URL rejected in production).
APP_URL="MY_APP_URL"

# ALLOWED_APP_ORIGINS: Optional comma-separated list of additional trusted HTTPS redirect origins.
ALLOWED_APP_ORIGINS=""

# TRUST_PROXY: Express reverse proxy trust configuration ('1' recommended for Cloud Run / LB, 'false' to disable).
# Never uses blind boolean 'true' in production.
TRUST_PROXY="1"

# GEMINI_API_KEY: Required only if Gemini AI enrichment/discovery features are invoked.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PASSWORD_RESET_TOKEN_TTL_MINUTES: Expiration window for single-use reset tokens.
PASSWORD_RESET_TOKEN_TTL_MINUTES="30"

# AUTH_RATE_LIMIT_FAILURE_MODE: Failure policy when shared PostgreSQL auth_rate_limits storage errors.
# - Production default when unset: "fail_closed" (HTTP 503 RATE_LIMITER_UNAVAILABLE)
# - Development/test default when unset: "fallback_local" (bounded in-memory fallback)
# AUTH_RATE_LIMIT_FAILURE_MODE="fail_closed"

# BILLING_WEBHOOK_SECRET: Secret for SandboxBillingProvider in development/test environments only.
BILLING_WEBHOOK_SECRET=""

# AIXSHOP_PLATFORM_REVIEWER_SECRET: Optional compliance reviewer credential (>= 32 chars).
# Required for POST /api/catalog/evidence/:evidenceId/review.
AIXSHOP_PLATFORM_REVIEWER_SECRET=""
# Optional reviewer key/principal metadata & rotation controls:
# AIXSHOP_PLATFORM_REVIEWER_PRINCIPAL_ID=""
# AIXSHOP_PLATFORM_REVIEWER_KEY_ID=""
# AIXSHOP_PLATFORM_REVIEWER_REVOKED_KEY_IDS=""
# AIXSHOP_PLATFORM_REVIEWER_USER_IDS=""
# AIXSHOP_REVIEWER_SERVICE_PRINCIPALS_JSON=""

# Optional external GTIN/compliance registry provider integration:
# AIXSHOP_EXTERNAL_REGISTRY_PROVIDER_NAME=""
# AIXSHOP_EXTERNAL_REGISTRY_PROVIDER_URL=""
# AIXSHOP_EXTERNAL_REGISTRY_API_KEY=""

# Dev-only safety flags (strictly forbidden / must remain unset or "false" in production):
# DISABLE_AUTH="false"
# ALLOW_INSECURE_HTTP="false"
# DISABLE_HMR="false"

# ------------------------------------------------------------------------------
# 2. AUTOMATED CI (DATABASE, ENCRYPTION & BACKGROUND SWEEPERS)
# ------------------------------------------------------------------------------
# SESSIONS:
# AIXSHOP v1.0 uses server-managed database-backed session records (SHA-256 hashed 256-bit tokens).
# No stateless SESSION_SECRET is required or used by the server.

# DATABASE_URL: PostgreSQL connection URI (e.g., postgresql://user:password@host:5432/dbname)
# Required in production and PostgreSQL integration tests.
DATABASE_URL=""

# Individual PostgreSQL connection parameters (alternative to DATABASE_URL; Precedence: DATABASE_URL > SQL_* > PG*):
SQL_HOST=""
SQL_PORT="5432"
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""

# Standard PostgreSQL fallback variables (used if SQL_* parameters are omitted):
# PGHOST=""
# PGPORT="5432"
# PGUSER=""
# PGPASSWORD=""
# PGDATABASE=""

# PostgreSQL SSL / TLS Configuration:
PGSSLMODE=""
PGSSLROOTCERT=""
SQL_CA_CERT=""
DATABASE_SSL=""
DATABASE_SSL_REJECT_UNAUTHORIZED="true"

# SHOPIFY_TOKEN_ENCRYPTION_KEY: 256-bit AES-GCM key (64-character hex string).
# MANDATORY in production and Shopify OAuth token persistence tests.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHOPIFY_TOKEN_ENCRYPTION_KEY=""

# Stripe Webhook Recovery Sweeper (Migration 013):
# CLI: npm run billing:recover [-- --limit=50 --max-attempts=5] or [-- --event-id=evt_...]
# BILLING_RECOVERY_ENABLED="false"
# BILLING_RECOVERY_INTERVAL_MS="60000"
# BILLING_RECOVERY_MAX_ATTEMPTS="5"

# Health & Readiness Probes:
# - GET /api/health/live   (HTTP 200: process responsive)
# - GET /api/health/ready  (HTTP 200: PostgreSQL ready; HTTP 503 otherwise)
# - GET /api/health        (HTTP 200/503)

# ------------------------------------------------------------------------------
# 3. SHOPIFY DEVELOPMENT STORE VERIFICATION (Stage 1)
# ------------------------------------------------------------------------------
# Partner App credentials for OAuth 2.0, Admin GraphQL sync, and signed webhooks:
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""

# Base public HTTPS URL for your AIXSHOP deployment (defaults to APP_URL when omitted):
SHOPIFY_APP_URL=""

# Custom OAuth callback URL (defaults to {SHOPIFY_APP_URL}/api/shopify/callback):
SHOPIFY_REDIRECT_URI=""

# Comma-separated scopes (default: "read_products"):
SHOPIFY_SCOPES="read_products"

# Pinned Shopify Admin GraphQL API version (default: "2026-10"):
SHOPIFY_API_VERSION="2026-10"

# Public URL for Shopify webhook deliveries (defaults to {SHOPIFY_APP_URL}/api/shopify/webhooks):
SHOPIFY_WEBHOOK_URL=""

# Commercial Verification Harness targets (required only for `npm run verify:shopify`):
# SHOPIFY_DEV_STORE_DOMAIN: Development store hostname (e.g. "aixshop-dev-store.myshopify.com")
SHOPIFY_DEV_STORE_DOMAIN=""
# SHOPIFY_DEV_ACCESS_TOKEN: Offline Admin API access token obtained from installing the app on the Dev Store
SHOPIFY_DEV_ACCESS_TOKEN=""
# SHOPIFY_TEST_PRODUCT_PREFIX: Prefix used when creating/cleaning safe test products (optional)
SHOPIFY_TEST_PRODUCT_PREFIX="AIXSHOP-VERIFY-"
# SHOPIFY_ALLOW_TEST_PRODUCT_MUTATION: Set "true" only to create+delete a temporary test product during verify:shopify
SHOPIFY_ALLOW_TEST_PRODUCT_MUTATION="false"

# ------------------------------------------------------------------------------
# 4. STRIPE TEST MODE VERIFICATION (Stage 2)
# ------------------------------------------------------------------------------
# In 'production', Stripe is required and fails closed if STRIPE_SECRET_KEY is missing.
BILLING_PROVIDER="stripe"

# STRIPE_SECRET_KEY: Secret API key (MUST be sk_test_... for Stage 2 Test Mode verification)
STRIPE_SECRET_KEY=""

# STRIPE_WEBHOOK_SECRET: Endpoint or Stripe CLI signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=""

# Authoritative Stripe Price IDs matching AIXSHOP plans ($49 Starter, $149 Growth, $499 Enterprise):
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_ENTERPRISE=""
# Legacy alias fallbacks supported by server config (prefer STRIPE_PRICE_* above):
# STRIPE_PRICE_ID_STARTER=""
# STRIPE_PRICE_ID_GROWTH=""
# STRIPE_PRICE_ID_ENTERPRISE=""

# Comma-separated custom HTTPS Stripe Checkout/Portal redirect domains (strictly separated):
VITE_STRIPE_CHECKOUT_DOMAINS=""
VITE_STRIPE_PORTAL_DOMAINS=""

# Commercial Verification Harness targets (required only for `npm run verify:stripe`):
STRIPE_TEST_CUSTOMER_EMAIL=""
# STRIPE_TEST_CLOCK_ENABLED: Set "true" to run Stripe Test Clock lifecycle & renewal/failure verification
STRIPE_TEST_CLOCK_ENABLED="false"

# ------------------------------------------------------------------------------
# 5. REAL SMTP PROVIDER VERIFICATION (Stage 3)
# ------------------------------------------------------------------------------
# Used by POST /api/auth/forgot-password and Stage 3 SMTP verification.
# In dev/test without SMTP_HOST, emails go to the in-memory dev_outbox sink (not real delivery).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_STARTTLS="true"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@aixshop.local"
SUPPORT_EMAIL="support@aixshop.local"
SMTP_REJECT_UNAUTHORIZED="true"
SMTP_TIMEOUT_MS="10000"

# Commercial Verification Harness target (required for `npm run verify:smtp`; prevents unsolicited email):
SMTP_TEST_RECIPIENT=""

# ------------------------------------------------------------------------------
# 6. STAGING END-TO-END VERIFICATION (Stage 4)
# ------------------------------------------------------------------------------
# Explicit opt-in guard required before ANY external commercial verifier contacts real APIs:
COMMERCIAL_VERIFY_EXTERNAL="false"

# Isolated staging application base URL (e.g. "https://staging.aixshop.example.com")
STAGING_BASE_URL=""

# Explicit safety acknowledgment when executing destructive/write test flows on staging (must NOT be production):
STAGING_CONFIRM_NON_PRODUCTION="false"

# Test account email/password used by isolated staging customer journey verification:
STAGING_TEST_USER_EMAIL=""
STAGING_TEST_USER_PASSWORD=""

# Controls automatic teardown of staging test records created during Stage 4:
STAGING_CLEANUP_ENABLED="true"
# Optional: allow http://localhost/127.0.0.1 staging verification targets when testing locally
# STAGING_ALLOW_LOCAL="false"
