{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:unit": "tsx --test \"src/domain/**/*.test.ts\" \"src/api/**/*.test.ts\" \"src/context/**/*.test.ts\" \"src/pages/**/*.test.ts\"",
    "test:contracts": "tsx --test \"src/server/commercialVerificationHarness.test.ts\" \"src/server/customerJourney.e2e.test.ts\" \"src/server/stripeAndSmtpReadiness.test.ts\"",
    "test:postgres": "tsx --test \"src/server/postgresEntitlements.test.ts\" \"src/server/shopifyWebhookStatusPostgres.test.ts\" \"src/server/db/migrate.test.ts\" \"src/server/shopifyAtomicProvenance.test.ts\"",
    "test:e2e:browser": "tsx --test \"e2e/*.test.ts\"",
    "test:simulated:artifact": "tsx scripts/verify/run-simulated-tests.ts",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:status": "tsx src/server/db/migrate.ts --status",
    "migrate": "tsx src/server/db/migrate.ts",
    "billing:recover": "tsx src/server/billing/recoverWebhooks.ts",
    "billing:retry-emails": "tsx src/server/billing/recoverEmails.ts",
    "config:check": "tsx src/server/config/checkConfig.ts",
    "verify:config": "tsx src/server/verification/checkCommercialEnv.ts",
    "verify:shopify": "tsx scripts/verify/run-shopify.ts",
    "verify:stripe": "tsx scripts/verify/run-stripe.ts",
    "verify:smtp": "tsx scripts/verify/run-smtp.ts",
    "verify:staging-e2e": "tsx scripts/verify/run-staging-e2e.ts",
    "verify:commercial:report": "tsx scripts/verify/generate-report.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "stripe": "^23.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
